---
import { fmtScore, fmtVisited, LEVEL_LABEL, detailPath, amapUrl, type PubRestaurant } from "../lib/food-data";
interface Props { r: PubRestaurant }
const { r } = Astro.props;
const score = fmtScore(r.score10);
const visited = fmtVisited(r);
// 客户端筛选/搜索用（纯 DOM，无坐标；haystack 已小写化便于 substring 命中）
const searchHay = [r.brand, r.branch ?? "", ...r.dishes.map((d) => d.name), ...r.cuisineTags]
  .join(" ").toLowerCase();
---
<article
  class="rc card"
  data-id={r.id}
  data-region={r.regionSlug}
  data-level={r.recommendationLevel}
  data-cuisines={r.cuisineTags.join("|")}
  data-search={searchHay}
  data-lng={r.lng ?? undefined}
  data-lat={r.lat ?? undefined}
>
  {/* 图片区 4:3：无图显示真实文字占位，不用示例图伪装实拍 */}
  <a class="rc-media" href={detailPath(r)} tabindex="-1" aria-hidden="true">
    {r.coverImage
      ? <img src={r.coverImage} alt={`${r.brand}实拍`} loading="lazy" />
      : <div class="rc-nophoto"><span>暂无照片</span></div>}
  </a>
  <div class="rc-body">
    <div class="rc-top">
      <h3 class="rc-name">
        <a href={detailPath(r)}>{r.brand}{r.branch && <span class="rc-branch"> · {r.branch}</span>}</a>
      </h3>
      <span class:list={["tag", { "tag--wubi": r.recommendationLevel === "wubiChi", "tag--fill": r.recommendationLevel === "yingChiBang", "tag--dai": r.recommendationLevel === "daiChi" }]}>
        {LEVEL_LABEL[r.recommendationLevel]}
      </span>
    </div>
    <div class="rc-meta">
      {r.cuisineTags.slice(0, 3).map((c) => <span class="rc-cuisine">{c}</span>)}
      {visited && <span class="rc-visited num">{visited}</span>}
    </div>
    {score
      ? <p class="rc-score"><span class="num">{score}</span>{r.reviewText && <span class="rc-review"> · {r.reviewText}</span>}</p>
      : r.reviewText && <p class="rc-review">{r.reviewText}</p>}
    {r.dishes.length > 0 && (
      <p class="rc-dishes">推荐：{r.dishes.slice(0, 3).map((d) => d.name).join("、")}{r.dishes.length > 3 && ` 等${r.dishes.length}样`}</p>
    )}
    <div class="rc-actions">
      {/* 导航：独立可点，直开高德，不嵌套在店名/图片链接内（DEVELOPMENT-PLAN §7） */}
      <a class="rc-nav" href={amapUrl(r)} target="_blank" rel="noopener noreferrer" aria-label={`在高德地图打开${r.brand}`}>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/>
        </svg>
        导航
      </a>
    </div>
  </div>
</article>

<style>
  .rc { overflow: hidden; transition: opacity var(--t), transform var(--t); }
  .rc-media { display: block; aspect-ratio: 4 / 3; background: var(--paper-2); }
  .rc-media img { width: 100%; height: 100%; object-fit: cover; }
  .rc-nophoto { width: 100%; height: 100%; display: grid; place-items: center; color: var(--ink-3); font-size: var(--fs-sub); }
  .rc-body { padding: var(--s-3) var(--s-4) var(--s-4); display: grid; gap: var(--s-2); }
  .rc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-3); }
  .rc-name { font-size: var(--fs-shop); letter-spacing: var(--ls-text); }
  .rc-name a { color: var(--ink); }
  .rc-name a:hover { text-decoration: none; border-bottom: 2px solid var(--brand); }
  .rc-branch { color: var(--ink-2); font-weight: 500; font-size: 0.85em; }
  .rc-meta { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sub); color: var(--ink-2); }
  .rc-cuisine + .rc-cuisine::before { content: "· "; }
  .rc-visited { margin-left: auto; color: var(--ink-3); }
  .rc-score { font-size: var(--fs-sub); }
  .rc-score .num { font-weight: 700; font-size: 1rem; }
  .rc-review { color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .rc-dishes { font-size: var(--fs-sub); color: var(--ink-2); }
  .rc-actions { display: flex; gap: var(--s-2); margin-top: var(--s-1); }
  .rc-nav {
    display: inline-flex; align-items: center; gap: 5px; min-height: 36px; padding: 0 var(--s-4);
    border: 1px solid var(--line); border-radius: var(--r-chip);
    font-size: var(--fs-sub); font-weight: 600; color: var(--ink);
  }
  .rc-nav:hover { text-decoration: none; border-color: var(--op); color: var(--op); }
  .rc-nav svg { flex: none; }
</style>
